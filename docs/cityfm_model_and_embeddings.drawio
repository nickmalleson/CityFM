<mxCell id="m22" value="&lt;b&gt;T · text encoder&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#64748B&quot;&gt;model.lm, model.projection_p&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="76" y="355" width="420" height="18" as="geometry"/></mxCell>
