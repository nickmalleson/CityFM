<mxCell id="m1" value="&lt;b&gt;CityFM is one model with two encoders, trained in three stages&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=30;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1570" height="40" as="geometry"/></mxCell>
<mxCell id="m2" value="Leeds v5. The three stages train parts of one network, which is saved as one file (Leeds_v5/Model/model.pkl). Embeddings are computed afterwards, with the model frozen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1570" height="26" as="geometry"/></mxCell>
