<mxCell id="m29" value="2-layer MLP" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="318" y="382" width="82" height="24" as="geometry"/></mxCell>
