<mxCell id="m59" value="&lt;b&gt;256 numbers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=4;fillColor=#DDD6FE;strokeColor=#7C3AED;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="402" y="798" width="88" height="24" as="geometry"/></mxCell>
<mxCell id="m60" value="A fixed formula with nothing to train, so no stage changes it. Nothing trains P to agree with T or V, so it is not compared with them. It is only joined to them for a task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="60" y="830" width="450" height="46" as="geometry"/></mxCell>
<mxCell id="m61" value="&lt;b&gt;Embedding&lt;/b&gt; means one of these vectors. A POI’s T and a street’s T come from the same weights, so they can be compared with each other as well." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="50" y="892" width="470" height="48" as="geometry"/></mxCell>
<mxCell id="m62" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="560" y="160" width="510" height="790" as="geometry"/></mxCell>
<mxCell id="m63" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=19;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="580" y="180" width="36" height="36" as="geometry"/></mxCell>
<mxCell id="m64" value="&lt;b&gt;Training · three stages in turn&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="628" y="182" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="m65" value="Each stage is a matching quiz on unlabelled data. It trains one encoder and leaves the other unchanged, and it starts from the weights saved by the stage before." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="580" y="232" width="470" height="76" as="geometry"/></mxCell>
