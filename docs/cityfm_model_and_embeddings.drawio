<mxCell id="m17" value="&lt;b&gt;The model&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="98" y="182" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="m18" value="One network, saved in one file. It has two encoders, and each turns its input into a list of 768 numbers. Position is encoded separately, by a fixed formula outside the model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="50" y="232" width="470" height="76" as="geometry"/></mxCell>
