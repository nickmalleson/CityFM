<mxCell id="m145" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=0;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1110" y="658" width="470" height="1" as="geometry"/></mxCell>
<mxCell id="m146" value="The maps in sections 8e and 9d instead combine the separate T of each POI, or the V of each footprint, within each hexagon." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="666" width="470" height="34" as="geometry"/></mxCell>
<mxCell id="m147" value="&lt;b&gt;For a task, an object’s vectors are joined end to end&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="712" width="470" height="20" as="geometry"/></mxCell>
<mxCell id="m148" value="&lt;b&gt;T&lt;/b&gt; · 768" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="1110" y="740" width="154" height="24" as="geometry"/></mxCell>
<mxCell id="m149" value="&lt;b&gt;V&lt;/b&gt; · 768" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="1267" y="740" width="154" height="24" as="geometry"/></mxCell>
<mxCell id="m150" value="&lt;b&gt;P&lt;/b&gt; · 256" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="1424" y="740" width="51" height="24" as="geometry"/></mxCell>
<mxCell id="m151" value="= 1,792" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1486" y="740" width="80" height="24" as="geometry"/></mxCell>
<mxCell id="m152" value="numbers for a building or an area (1,024 for a POI or a street, which have no V)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="768" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="m153" value="" style="edgeStyle=none;html=1;strokeColor=#94A3B8;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="790" as="sourcePoint"/><mxPoint x="1345" y="806" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m154" value="&lt;b&gt;A small model is trained on labelled examples for that task&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;an MLP in the shipped code, ridge regression in the Leeds population test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1110" y="808" width="470" height="46" as="geometry"/></mxCell>
<mxCell id="m155" value="" style="edgeStyle=none;html=1;strokeColor=#94A3B8;strokeWidth=1.6;endArrow=block;endFill=1;endSize=5" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345" y="854" as="sourcePoint"/><mxPoint x="1345" y="870" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m156" value="a prediction, such as people per km²" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="872" width="470" height="20" as="geometry"/></mxCell>
<mxCell id="m157" value="CityFM itself is not changed by a task." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="896" width="470" height="20" as="geometry"/></mxCell>
<mxCell id="m158" value="&lt;b&gt;In short.&lt;/b&gt; There is one model, not three. T, V and P are three kinds of vector. T and V come from the model’s two trained encoders, and a V can be compared with a T because stage 2 trained V to match the T of a building’s own tags. P comes from a fixed formula outside the model. A POI, building, street or area is described by whichever of the three apply, and a task joins them." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#1E293B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="30" y="968" width="1570" height="64" as="geometry"/></mxCell>
<mxCell id="m159" value="† encoder.py has no text encoding for road segments, and the shipped speed task does not call the model. The notebook computes segment context vectors itself.   &lt;b&gt;Not shown.&lt;/b&gt; model.pkl also holds three small layers that no stage trains or uses.   &lt;b&gt;Where the paper differs.&lt;/b&gt; The paper trains on the sum of the three losses at once, while this code runs the stages in turn. The paper describes a context by the mean of its entities’ T (Eq. 3), while the code averages BERT’s word vectors over all the entities and applies the MLP once. The paper’s V has an MLP after ResNet-18 and another after the mean (Eqs. 4 and 6), where the code has one linear layer and nothing after the mean." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="1044" width="1570" height="56" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
