<mxCell id="m36" value="Stage 2 trains V so that a building’s V is similar to the T of its own tags. A footprint can therefore be compared directly with a text, by cosine similarity." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="106" y="543" width="398" height="52" as="geometry"/></mxCell>
