<mxCell id="m32" value="Reads the tags of one or more entities, without names, such as ‘shop: bakery’. The average runs over the words, and over the entities when there are several. BERT starts from its pre-training on English text. The MLP starts from random weights." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="76" y="416" width="420" height="62" as="geometry"/></mxCell>
<mxCell id="m33" value="&lt;b&gt;one entity&lt;/b&gt; → its T&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a POI, or a building’s tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="66" y="490" width="214" height="44" as="geometry"/></mxCell>
<mxCell id="m34" value="&lt;b&gt;several entities&lt;/b&gt; → one T&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a street’s context, or an area&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="290" y="490" width="214" height="44" as="geometry"/></mxCell>
