<mxCell id="s85" value="2.95" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1493.0" y="360" width="90" height="22" as="geometry"/></mxCell>
