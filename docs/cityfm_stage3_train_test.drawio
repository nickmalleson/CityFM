<mxCell id="s91" value="0.29" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1285.6" y="420" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="s92" value="The loss stays close to guessing for all 270 steps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="452" width="470" height="40" as="geometry"/></mxCell>
<mxCell id="s93" value="&lt;b&gt;Share of the way from guessing to the floor&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="570" width="470" height="20" as="geometry"/></mxCell>
