<mxCell id="s1" value="&lt;b&gt;Stage 3: how CityFM matches streets by their number of bus routes, and why it learns little&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=30;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1570" height="40" as="geometry"/></mxCell>
<mxCell id="s2" value="A street is described by the things near it, read as types without names. Bus routes decide only which streets are paired." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1570" height="26" as="geometry"/></mxCell>
