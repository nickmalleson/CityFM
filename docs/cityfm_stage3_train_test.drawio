<mxCell id="s41" value="Street C shares 8 types of entry with A, and A′ only 2. But C carries 2 routes, so here it counts as a wrong answer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="50" y="520" width="175" height="110" as="geometry"/></mxCell>
<mxCell id="s42" value="&lt;b&gt;What is trained&lt;/b&gt;&lt;br&gt;BERT and the text projection, the same text side as stage 1, at a tenth of its learning rate. The footprint side is not changed, but the text embeddings it was trained to match are." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=14;spacingTop=4" vertex="1" parent="1"><mxGeometry x="50" y="690" width="470" height="110" as="geometry"/></mxCell>
<mxCell id="s43" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="560" y="160" width="510" height="670" as="geometry"/></mxCell>
<mxCell id="s44" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=19;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="580" y="180" width="36" height="36" as="geometry"/></mxCell>
<mxCell id="s45" value="&lt;b&gt;How a quiz is drawn&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="628" y="182" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="s46" value="All segments are shuffled and cut into windows of 1,024. In each window, the segments on a bus route are taken in turn and paired with the first unpaired one within one route of them. No pair starts from a number of routes already used in the quiz." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="580" y="232" width="470" height="80" as="geometry"/></mxCell>
<mxCell id="s47" value="&lt;b&gt;1,024 segments&lt;/b&gt;&lt;br&gt;in a window" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="580" y="325" width="140" height="50" as="geometry"/></mxCell>
