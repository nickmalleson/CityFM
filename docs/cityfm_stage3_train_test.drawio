<mxCell id="s95" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#93C5FD;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1255" y="602" width="175" height="18" as="geometry"/></mxCell>
<mxCell id="s96" value="25%" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1438" y="600" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="s97" value="Stage 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="630" width="140" height="22" as="geometry"/></mxCell>
<mxCell id="s98" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#93C5FD;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1255" y="632" width="210" height="18" as="geometry"/></mxCell>
<mxCell id="s99" value="30%" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1473" y="630" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="s100" value="&lt;b&gt;Stage 3&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="660" width="140" height="22" as="geometry"/></mxCell>
<mxCell id="s101" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#2563EB;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1255" y="662" width="28" height="18" as="geometry"/></mxCell>
<mxCell id="s102" value="&lt;b&gt;4%&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1291" y="660" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="s103" value="Stages 1 and 2 add 4 quizzes of 64 pairs per step, so their losses are on another scale. The share of the way can be compared across stages." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="692" width="470" height="60" as="geometry"/></mxCell>
<mxCell id="s104" value="&lt;b&gt;What it shows.&lt;/b&gt; Stage 3 barely learns. Its loss ends 4% of the way from guessing to the floor, against 25% and 30% for stages 1 and 2. Pairing streets by their number of bus routes gives the model little to learn, and each epoch uses only about 1,100 of the 55,439 segments. &lt;b&gt;Next:&lt;/b&gt; replace the target with each street&#x27;s network profile (angular integration and choice at several radii), which every segment has." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="30" y="850" width="1570" height="76" as="geometry"/></mxCell>
<mxCell id="s105" value="&lt;b&gt;Guessing&lt;/b&gt;: every candidate scored the same, log(2n − 1) for n pairs.   &lt;b&gt;Floor&lt;/b&gt;: partners identical and decoys opposite, which cannot be reached but shows the scale.   Panels 1 and 2 show one real Leeds window, with 4 of the commonest entries in each context." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="938" width="1570" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
