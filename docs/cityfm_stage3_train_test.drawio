<mxCell id="s77" value="Stage 3 uses 2% of the segments in an epoch, against 58% for stage 1. Five epochs give 270 quizzes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="580" y="722" width="470" height="40" as="geometry"/></mxCell>
<mxCell id="s78" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1090" y="160" width="510" height="670" as="geometry"/></mxCell>
<mxCell id="s79" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=19;fontColor=#1E293B;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#FFFFFF;spacingLeft=0;spacingRight=0" vertex="1" parent="1"><mxGeometry x="1110" y="180" width="36" height="36" as="geometry"/></mxCell>
<mxCell id="s80" value="&lt;b&gt;Result · the training loss&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1158" y="182" width="430" height="32" as="geometry"/></mxCell>
<mxCell id="s81" value="There is no separate test for stage 3. The loss is low when each street&#x27;s context is more similar to its partner&#x27;s than to the decoys. With about 10 pairs per quiz, guessing gives 2.95." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="232" width="470" height="80" as="geometry"/></mxCell>
<mxCell id="s82" value="&lt;b&gt;Stage 3 loss, last 25 steps (lower is better)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="330" width="470" height="20" as="geometry"/></mxCell>
