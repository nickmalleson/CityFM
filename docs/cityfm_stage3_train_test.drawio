<mxCell id="s87" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#2563EB;strokeColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=13;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1255" y="392" width="222.2" height="18" as="geometry"/></mxCell>
<mxCell id="s88" value="&lt;b&gt;2.85&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1485.2" y="390" width="90" height="22" as="geometry"/></mxCell>
<mxCell id="s89" value="Floor" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="140" height="22" as="geometry"/></mxCell>
