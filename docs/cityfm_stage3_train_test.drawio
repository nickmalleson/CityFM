<mxCell id="s12" value="Each street on a bus route is paired with another that carries about the same number of routes, anywhere in Leeds. The model is adjusted so that each street&#x27;s context is more similar to its partner&#x27;s than to the other streets in the quiz. Repeated for 270 quizzes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="50" y="232" width="470" height="80" as="geometry"/></mxCell>
