Cell><mxCell id="c375" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;endSize=4.29" edge="1" parent="c323"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="78" as="sourcePoint" /><mxPoint x="526" y="78" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c376" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c323"><mxGeometry x="547" y="44" width="164" height="68" as="geometry" /></mxCell><mxCell id="c377" value="&lt;div style=&quot;line-height:11.9px&quot;&gt;POSITIVE&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=1" vertex="1" parent="c323"><mxGeometry x="557" y="45.26" width="50.08" height="11.9" as="geometry" /></mxCell><mxCell id="c378" value="&lt;div style=&quot;line-height:14.5px&quot;&gt;context of a segment b&lt;br&gt;with |l_a − l_b| ≤ 0.02&lt;br&gt;(can be anywhere)&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c323"><mxGeometry x="557" y="60.27" width="148.83" height="43.5" as="geometry" /></mxCell><mxCell id="c379" value="&lt;div style=&quot;line-height:16.5px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Trains&lt;/span&gt;&lt;span style=&quot;margin-left:3.3px&quot;&gt;T (BERT + MLP), lr 1e-5 decaying to 0. Pairs from windows of 1,024 segments: ≈ 10 per quiz. 270 steps.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Learns&lt;/span&gt;: segments with a similar role in the bus network get similar context embeddings.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c323"><mxGeometry x="16" y="121.09" width="673.14" height="33" as="geometry" /></mxCell><mxCell id="c380" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Leeds&lt;/span&gt;&lt;span style=&quot;margin-left:3.3px&quot;&gt;v5: barely learns (the loss ends 4% of the way from guessing to the floor);&lt;/span&gt;&lt;br&gt;only the 10% of segments on a bus route take part.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#0F766E" vertex="1" parent="c323"><mxGeometry x="16" y="154.84" width="627.3" height="30" as="geometry" /></mxCell><mxCell id="c381" value="col4-embeddings" parent="0" /><mxCell id="c382" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c381"><mxGeometry x="1440" y="136" width="330" height="408" as="geometry" /></mxCell><mxCell id="c383" value="" style="group" vertex="1" connectable="0" parent="c381"><mxGeometry x="1454" y="150.9" width="26" height="26.1" as="geometry" /></mxCell><mxCell id="c384" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=none" vertex="1" parent="c383"><mxGeometry x="0" y="0.1" width="26" height="26" as="geometry" /></mxCell><mxCell id="c385" value="&lt;div style=&quot;line-height:17.5px&quot;&gt;4&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=no