tFamily=Menlo;fontSize=12.5;fontColor=#1E293B;fontStyle=1" vertex="1" parent="c468"><mxGeometry x="1454" y="819.87" width="82.25" height="15.6" as="geometry" /></mxCell><mxCell id="c503" value="&lt;div style=&quot;line-height:15.5px&quot;&gt;untagged building (footprint + context&lt;br&gt;+ position) → land-use class&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c468"><mxGeometry x="1454" y="837.09" width="252.24" height="31" as="geometry" /></mxCell><mxCell id="c504" value="&lt;div style=&quot;line-height:15.6px&quot;&gt;avg_speed&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Menlo;fontSize=12.5;fontColor=#1E293B;fontStyle=1" vertex="1" parent="c468"><mxGeometry x="1454" y="878.37" width="74.62" height="15.6" as="geometry" /></mxCell><mxCell id="c505" value="&lt;div style=&quot;line-height:15px&quot;&gt;road segment → mean traffic speed&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c468"><mxGeometry x="1454" y="895.84" width="219.84" height="15" as="geometry" /></mxCell><mxCell id="c506" value="&lt;div style=&quot;line-height:14.4px&quot;&gt;shipped code never calls the model&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#64748B" vertex="1" parent="c468"><mxGeometry x="1454" y="911.82" width="217.14" height="14.4" as="geometry" /></mxCell><mxCell id="c507" value="&lt;div style=&quot;line-height:15.5px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Leeds&lt;/span&gt; (500 m grid, R²): v5 features 0.74;&lt;br&gt;9 simple OSM counts 0.76; counts +&lt;br&gt;position 0.80, so CityFM adds nothing&lt;br&gt;to the counts. Next: IMD, EPC built&lt;br&gt;form / age, DfT traffic counts.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#0F766E" vertex="1" parent="c468"><mxGeometry x="1454" y="931.09" width="267.6" height="78" as="geometry" /></mxCell><mxCell id="c508" value="flow-arrows" parent="0" /><mxCell id="c509" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#1E293B;strokeWidth=2.5;endArrow=block;endFill=1;endSize=4.4" edge="1" parent="c508"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="164" as="sourcePoint" /><mxPoint x="313" y="164" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c510" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#1E293B;strokeWidth=2.5;endArrow=block;endFill=1;endSize=4.4" edge="1" parent="c508"><mxGeometry relative="1" as="geometry"><mxPoint x="625" y="164" as="sourcePoint" /><mxPoint x="653" y="164" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c511" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#1E293B;strokeWidth=2.5;endArrow=block;endFill=1;endSize=4.4" edge="1" parent="c508"><mxGeometry relative="1" as="geometry"><mxPoint x="1407" y="164" as="sourcePoint" /><mxPoint x="1435" y="164" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c512" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#1E293B;strokeWidth=2.5;endArrow=block;endFill=1;endSize=4.4" edge="1" parent="c508"><mxGeometry relative="1" as="geometry"><mxPoint x="1605" y="549" as="sourcePoint" /><mxPoint x="1605" y="583" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c513" value="&lt;div style=&quot;line-height:14.4px&quot;&gt;frozen embeddings + labels&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#64748B" vertex="1" parent="c508"><mxGeometry x="1619" y="555.32" width="167.46" height="14.4" as="geometry" /></mxCell><mxCell id="c514" value="notes" parent="0" /><mxCell id="c515" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c514"><mxGeometry x="30" y="1102" width="861" height="120" as="geometry" /></mxCell><mxCell id="c516" value="&lt;div style=&quot;line-height:17.5px&quot;&gt;Where this code differs from the paper&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B;fontStyle=1" vertex="1" parent="c514"><mxGeometry x="46" y="1109.9" width="314.56" height="17.5" as="geometry" /></mxCell><mxCell id="c517" value="&lt;div style=&quot;line-height:17px&quot;&gt;• The paper sums the three losses into one; the code trains the three stages one after another.&lt;br&gt;• Stages 1 and 2 stop each epoch after a set number of items (-m), however big the city; v5 used 32,000 and 64,000.&lt;br&gt;• Stage 3 pairs segments whose weights differ by ≤ 0.02 (paper: θ = 0.05).&lt;br&gt;• Added for Leeds: houses merged in contexts; ImageNet weights; footprints in metres; learning-rate fix; no names.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c514"><mxGeometry x="46" y="1132.84" width="621.6" height="68" as="geometry" /></mxCell><mxCell id="c518" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c514"><mxGeometry x="909" y="1102" width="861" height="120" as="geometry" /></mxCell><mxCell id="c519" value="&lt;div style=&quot;line-height:17.5px&quot;&gt;Leeds case study&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#0F766E;fontStyle=1" vertex="1" parent="c514"><mxGeometry x="925" y="1109.9" width="135.92" height="17.5" as="geometry" /></mxCell><mxCell id="c520" value="&lt;div style=&quot;line-height:17px&quot;&gt;• Current model v5: trained from scratch on the research server (CPU, ~12 h) → Leeds_v5/Model/model.pkl.&lt;br&gt;• Inputs: Leeds_v2/Data (houses merged); names left out of all text (--no-names), in training and when embedding.&lt;br&gt;• Stages 1 and 2 learn; stage 3 barely does. Planned next: replace its bus-route target with street-network metrics.&lt;br&gt;• The Leeds figures here come from notebooks/leeds_embeddings.ipynb (sections 6–10).&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c514"><mxGeometry x="925" y="1132.84" width="783.6" height="68" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>