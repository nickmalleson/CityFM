="c169" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;endSize=5" edge="1" parent="c161"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="68" as="sourcePoint" /><mxPoint x="114" y="68" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c170" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.2" vertex="1" parent="c161"><mxGeometry x="124" y="42" width="52" height="52" as="geometry" /></mxCell><mxCell id="c171" value="" style="shape=image;verticalLabelPosition=bottom;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MiIgaGVpZ2h0PSIzMCIgdmlld0JveD0iNDU5IDg5MyA0MiAzMCI+PHBvbHlnb24gcG9pbnRzPSI0NjAsODk0IDUwMCw4OTQgNTAwLDkyMiA0ODIsOTIyIDQ4Miw5MDggNDYwLDkwOCIgZmlsbD0iIzFFMjkzQiIvPjwvc3ZnPg==" vertex="1" parent="c161"><mxGeometry x="129" y="53" width="42" height="30" as="geometry" /></mxCell><mxCell id="c172" value="&lt;div style=&quot;line-height:13.1px&quot;&gt;224 × 224&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B" vertex="1" parent="c161"><mxGeometry x="121.49" y="95.31" width="57.03" height="13.1" as="geometry" /></mxCell><mxCell id="c173" value="&lt;div style=&quot;line-height:14px&quot;&gt;+ area&lt;br&gt;(m²)&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#64748B" vertex="1" parent="c161"><mxGeometry x="192" y="48.69" width="41.64" height="28" as="geometry" /></mxCell><mxCell id="c174" value="&lt;div style=&quot;line-height:15.5px&quot;&gt;Rotated and scaled to fill the image, so&lt;br&gt;it carries shape only; area enters as&lt;br&gt;min(m², 5,000) ÷ 5,000. Made on the fly&lt;br&gt;in stage 2.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c161"><mxGeometry x="14" y="117.59" width="265.2" height="62" as="geometry" /></mxCell><mxCell id="c178" value="&lt;div style=&quot;line-height:15px&quot;&gt;Drawn in metres (longitude × cos latitude),&lt;br&gt;so shapes keep their true proportions&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c161"><mxGeometry x="14" y="185.52" width="235.77" height="30" as="geometry" /></mxCell><mxCell id="c179" value="col3-pretraining" parent="0" /><mxCell id="c180" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c179"><mxGeometry x="658" y="136" width="744" height="948" as="geometry" /></mxCell><mxCell id="c181" value="" style="group" vertex="1" connectable="0" parent="c179"><mxGeometry x="672" y="150.9" width="26" height="26.1" as="geometry" /></mxCell><mxCell id="c182" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=none" vertex="1" parent="c181"><mxGeometry x="0" y="0.1" width="26" height="26" as="geometry" /></mxCell><mxCell id="c183" value="&lt;div style=&quot;line-height:17.5px&quot;&gt;3&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="c181"><mxGeometry x="5.94" y="0" width="14.12" height="17.5" as="geometry" /></mxCell><mxCell id="c184" value="&lt;div style=&quot;line-height:20.6px&quot;&gt;Pre-training: three contrastive stages&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16.5;fontColor=#1E293B;fontStyle=1" vertex="1" parent="c179"><mxGeometry x="706" y="148.98" width="369.66" height="20.6" as="geometry" /></mxCell><mxCell id="c185" value="&lt;div style=&quot;line-height:15.5px&quot;&gt;CityFM_train.py --no-names runs the stages in order, each continuing from the previous weights, and saves&lt;br&gt;Leeds_v5/Model/model.pkl. The model holds two encoders, T and V. Each stage trains one of them.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#64748B" vertex="1" parent="c179"><mxGeometry x="674" y="177.59" width="641.04" height="31" as="geometry" /></mxCell><mxCell id="mfix1" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;fillColor=none;strokeColor=#1E293B;strokeWidth=1.6" vertex="1" parent="c179"><mxGeometry x="667" y="214" width="484.6" height="132" as="geometry" /></mxCell><mxCell id="mfix2" value="&lt;b&gt;model.pkl&lt;/b&gt; · the trained model, with two encoders" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c179"><mxGeometry x="679" y="218" width="300" height="16" as="geometry" /></mxCell><mxCell id="mfix3" value="not in the model · a fixed formula" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#64748B" vertex="1" parent="c179"><mxGeometry x="1160" y="218" width="226" height="16" as="geometry" /></mxCell><mxCell id="c186" value="" style="group" vertex="1" connectable="0" parent="c179"><mxGeometry x="674" y="238" width="712" height="104" as="geometry" /></mxCell><mxCell id="c187" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.4" vertex="1" parent="c186"><mxGeometry x="0" y="0" width="229.3" height="104" as="geometry" /></mxCell><mxCell id="c188" value="" style="group" vertex="1" connectable="0" parent="c186"><mxGeometry x="12" y="12" width="8" height="18" as="geometry" /></mxCell><mxCell id="c189" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2" vertex="1" parent="c188"><mxGeometry x="0" y="0" width="8" height="8" as="geometry" /></mxCell><mxCell id="c190" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2" vertex="1" parent="c188"><mxGeometry x="0" y="10" width="8" height="8" as="geometry" /></mxCell><mxCell id="c191" value="&lt;div style=&quot;line-height:16.9px&quot;&gt;&lt;span style=&quot;font-weight:bold;color:#2563EB&quot;&gt;T&lt;/span&gt;&lt;span style=&quot;margin-left:7.5px;font-weight:bold&quot;&gt;text encoder&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="28" y="7.37" width="115.29" height="16.9" as="geometry" /></mxCell><mxCell id="c192" value="&lt;div style=&quot;line-height:15px&quot;&gt;tag string (no names) → BERT-base&lt;br&gt;→ mean over tokens (and over&lt;br&gt;entities, for a context) → 2-layer&lt;br&gt;MLP → 768-d&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="12" y="30.02" width="217.14" height="60" as="geometry" /></mxCell><mxCell id="c193" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=1.4" vertex="1" parent="c186"><mxGeometry x="241.3" y="0" width="229.3" height="104" as="geometry" /></mxCell><mxCell id="c194" value="" style="group" vertex="1" connectable="0" parent="c186"><mxGeometry x="253.3" y="12" width="8" height="18" as="geometry" /></mxCell><mxCell id="c195" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.2" vertex="1" parent="c194"><mxGeometry x="0" y="0" width="8" height="8" as="geometry" /></mxCell><mxCell id="c196" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.2" vertex="1" parent="c194"><mxGeometry x="0" y="10" width="8" height="8" as="geometry" /></mxCell><mxCell id="c197" value="&lt;div style=&quot;line-height:16.9px&quot;&gt;&lt;span style=&quot;font-weight:bold;color:#EA580C&quot;&gt;V&lt;/span&gt;&lt;span style=&quot;margin-left:7.5px;font-weight:bold&quot;&gt;visual encoder&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="269.3" y="7.37" width="130.95" height="16.9" as="geometry" /></mxCell><mxCell id="c198" value="&lt;div style=&quot;line-height:15px&quot;&gt;image → ResNet-18 → linear → 768-d;&lt;br&gt;area → small MLP → 768-d;&lt;br&gt;V = mean of the two&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="253.3" y="30.02" width="223.35" height="45" as="geometry" /></mxCell><mxCell id="c202" value="&lt;div style=&quot;line-height:14.4px&quot;&gt;ResNet-18 from ImageNet weights&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="253.3" y="80.32" width="186.09" height="14.4" as="geometry" /></mxCell><mxCell id="c203" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.4;dashed=1;dashPattern=5 3" vertex="1" parent="c186"><mxGeometry x="482.7" y="0" width="229.3" height="104" as="geometry" /></mxCell><mxCell id="c204" value="" style="group" vertex="1" connectable="0" parent="c186"><mxGeometry x="494.7" y="12" width="8" height="18" as="geometry" /></mxCell><mxCell id="c205" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.2" vertex="1" parent="c204"><mxGeometry x="0" y="0" width="8" height="8" as="geometry" /></mxCell><mxCell id="c206" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.2" vertex="1" parent="c204"><mxGeometry x="0" y="10" width="8" height="8" as="geometry" /></mxCell><mxCell id="c207" value="&lt;div style=&quot;line-height:16.9px&quot;&gt;&lt;span style=&quot;font-weight:bold;color:#7C3AED&quot;&gt;P&lt;/span&gt;&lt;span style=&quot;margin-left:7.5px;font-weight:bold&quot;&gt;position code&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="510.7" y="7.37" width="83.97" height="16.9" as="geometry" /></mxCell><mxCell id="c208" value="&lt;div style=&quot;line-height:15px&quot;&gt;lat, lon → fixed sin/cos waves at&lt;br&gt;64 frequencies → 256-d. Not learned.&lt;br&gt;Joined to T and V only for tasks.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c186"><mxGeometry x="494.7" y="30.02" width="210.93" height="45" as="geometry" /></mxCell><mxCell id="c209" value="&lt;div style=&quot;line-height:17px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Every stage is a matching quiz on unlabelled data.&lt;/span&gt;&lt;span style=&quot;margin-left:3.5px&quot;&gt;A batch holds N true (anchor, positive) pairs. The InfoNCE loss&lt;/span&gt;&lt;br&gt;(temperature 0.5) is low when each anchor is more similar to its own positive than to the other N − 1 positives&lt;br&gt;and the other N − 1 anchors, which act as decoys. The same holds for each positive.&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B" vertex="1" parent="c179"><mxGeometry x="674" y="350.67" width="797.25" height="51" as="geometry" /></mxCell><mxCell id="c210" value="" style="group" vertex="1" connectable="0" parent="c179"><mxGeometry x="674" y="416" width="753.46" height="196" as="geometry" /></mxCell><mxCell id="c211" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c210"><mxGeometry x="0" y="0" width="712" height="196" as="geometry" /></mxCell><mxCell id="c212" value="&lt;div style=&quot;line-height:18.8px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Stage 1 · Infomax&lt;/span&gt;&lt;span style=&quot;margin-left:16.7px&quot;&gt;entity ↔ the context it sits in&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B" vertex="1" parent="c210"><mxGeometry x="16" y="5.9" width="421.7" height="18.8" as="geometry" /></mxCell><mxCell id="c213" value="" style="group" vertex="1" connectable="0" parent="c210"><mxGeometry x="679" y="7.63" width="17" height="20.37" as="geometry" /></mxCell><mxCell id="c214" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none" vertex="1" parent="c213"><mxGeometry x="0" y="3.37" width="17" height="17" as="geometry" /></mxCell><mxCell id="c215" value="&lt;div style=&quot;line-height:14.5px&quot;&gt;B&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.6;fontColor=#FFFFFF;fontStyle=1" vertex="1" parent="c213"><mxGeometry x="2.14" y="0" width="12.73" height="14.5" as="geometry" /></mxCell><mxCell id="c216" value="&lt;div style=&quot;line-height:14.4px&quot;&gt;uses&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=right;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSi