;fontSize=16;fontColor=#2563EB;fontStyle=1" vertex="1" parent="c210"><mxGeometry x="483.36" y="55.96" width="15.28" height="20" as="geometry" /></mxCell><mxCell id="c258" value="&lt;div style=&quot;line-height:13.1px&quot;&gt;trained&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#2563EB" vertex="1" parent="c210"><mxGeometry x="468.15" y="76.31" width="45.69" height="13.1" as="geometry" /></mxCell><mxCell id="c259" value="" style="edgeStyle=none;html=1;rounded=0;curved=0;startArrow=none;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;endSize=4.29" edge="1" parent="c210"><mxGeometry relative="1" as="geometry"><mxPoint x="544" y="78" as="sourcePoint" /><mxPoint x="526" y="78" as="targetPoint" /></mxGeometry></mxCell><mxCell id="c260" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="c210"><mxGeometry x="547" y="44" width="164" height="68" as="geometry" /></mxCell><mxCell id="c261" value="&lt;div style=&quot;line-height:11.9px&quot;&gt;POSITIVE&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=1" vertex="1" parent="c210"><mxGeometry x="557" y="45.26" width="50.08" height="11.9" as="geometry" /></mxCell><mxCell id="c262" value="&lt;div style=&quot;line-height:14.5px&quot;&gt;the whole context of s&lt;br&gt;(all its entities; the&lt;br&gt;anchor is included)&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B" vertex="1" parent="c210"><mxGeometry x="557" y="60.27" width="142.62" height="43.5" as="geometry" /></mxCell><mxCell id="c263" value="&lt;div style=&quot;line-height:16.5px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Trains&lt;/span&gt;&lt;span style=&quot;margin-left:3.3px&quot;&gt;T (BERT + MLP), lr 1e-4 decaying to 0. Quiz: 64 segments; decoys are the other 63 contexts and 63 entities. 625 steps.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Learns&lt;/span&gt;: entities found along the same streets get similar embeddings (e.g. pub moves towards theatre, hostel).&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B" vertex="1" parent="c210"><mxGeometry x="16" y="121.09" width="724.98" height="33" as="geometry" /></mxCell><mxCell id="c264" value="&lt;div style=&quot;line-height:15px&quot;&gt;&lt;span style=&quot;font-weight:bold&quot;&gt;Leeds&lt;/span&gt;&lt;span style=&quot;margin-left:3.3px&quot;&gt;v5: with the POI held out, it finds the right street 7.0% of the time (untuned BERT 4.2%, guessing 1.6%);&lt;/span&gt;&lt;br&gt;categories found together become similar (ρ 0.62, against 0.18 for untuned BERT).&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#0F766E" vertex="1" parent="c210"><mxGeometry x="16" y="154.84" width="737.46" height="30" as="geometry" /></mxCell><mxCell id="c265" value="" style="group" vertex="1" connectable="0" parent="c179"><mxGeometry x="674" y="645" width="721.54" height="196" as="geometry" /></mxCell><mxCell id="c266" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1