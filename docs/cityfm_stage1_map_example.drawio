<mxCell id="m205" value="which street&lt;br&gt;is it from?" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="850" width="140" height="40" as="geometry"/></mxCell>
<mxCell id="m206" value="&lt;b&gt;Why there are two tests.&lt;/b&gt; In training and test 1 the café is still on its street, so a model can score well by matching the word &lt;i&gt;cafe&lt;/i&gt; without learning anything about places. Test 2 removes that shortcut. A model can only pass it if it has learned which kinds of place are usually found near each other, which is what stage 1 is meant to teach." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=16;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=4;spacingRight=18" vertex="1" parent="1"><mxGeometry x="30" y="1185" width="1570" height="70" as="geometry"/></mxCell>
<mxCell id="m207" value="The streets and objects are invented for illustration. In the real data the 100 m is measured from the points that make up each mapped road segment, and each quiz uses 64 streets drawn at random from the city." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="1269" width="1570" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
