olor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1649.0" y="396" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q130" value="shop: hairdresser" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1548.0" y="425" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q131" value="amenity: parking" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1649.0" y="425" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q132" value="" style="edgeStyle=none;html=1;strokeColor=#16A34A;strokeWidth=2.2;endArrow=block;endFill=1;endSize=4;startArrow=block;startFill=1;startSize=4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1442" y="416" as="sourcePoint"/><mxPoint x="1538" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q133" value="" style="edgeStyle=none;html=1;strokeColor=#DC2626;strokeWidth=1.4;dashed=1;dashPattern=4 3;endArrow=block;endFill=1;endSize=4;startArrow=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1442" y="298" as="sourcePoint"/><mxPoint x="1538" y="406" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q134" value="… only about 10 pairs per quiz: just 10% of streets carry a bus route" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="491" width="520" height="16" as="geometry"/></mxCell><mxCell id="q135" value="&lt;b&gt;Similar&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="578" width="140" height="16" as="geometry"/></mxCell><mxCell id="q136" value="two streets with a similar number of bus routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1370" y="578" width="380" height="44" as="geometry"/></mxCell><mxCell id="q137" value="&lt;b&gt;Different&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="628" width="140" height="16" as="geometry"/></mxCell><mxCell id="q138" value="streets with a different number of bus routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1370" y="628" width="380" height="44" as="geometry"/></mxCell><mxCell id="q139" value="&lt;b&gt;Trained&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="678" width="140" height="16" as="geometry"/></mxCell><mxCell id="q140" value="BERT + text projection (T on both sides), at a tenth of stage 1&#x27;s learning rate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1370" y="678" width="380" height="44" as="geometry"/></mxCell><mxCell id="q141" value="&lt;b&gt;Should teach&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="728" width="140" height="16" as="geometry"/></mxCell><mxCell id="q142" value="streets with a similar role in the network get similar context embeddings" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1370" y="728" width="380" height="44" as="geometry"/></mxCell><mxCell id="q143" value="&lt;b&gt;Settings (v5)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="778" width="140" height="16" as="geometry"/></mxCell><mxCell id="q144" value="270 steps of 1 quiz; names left out" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1370" y="778" width="380" height="44" as="geometry"/></mxCell><mxCell id="q145" value="&lt;b&gt;Barely learns&lt;/b&gt; (loss 4% of the way from guessing to the floor). Bus-route counts say little about a street&#x27;s surroundings. &lt;b&gt;Planned:&lt;/b&gt; match each street&#x27;s context to its own network profile (integration and choice at several radii)." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="1230" y="844" width="520" height="62" as="geometry"/></mxCell><mxCell id="q146" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="1"><mxGeometry x="30" y="958" width="1740" height="253" as="geometry"/></mxCell><mxCell id="q147" value="&lt;b&gt;What every stage does with a batch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="50" y="972" width="600" height="20" as="geometry"/></mxCell><mxCell id="q148" value="partner" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="130" y="1004" width="120" height="14" as="geometry"/></mxCell><mxCell id="q149" value="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="130" y="1020" width="26" height="14" as="geometry"/></mxCell><mxCell id="q150" value="2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="160" y="1020" width="26" height="14" as="geometry"/></mxCell><mxCell id="q151" value="3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="1020" width="26" height="14" as="geometry"/></mxCell><mxCell id="q152" value="4" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="220" y="1020" width="26" height="14" as="geometry"/></mxCell><mxCell id="q153" value="item 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="1046" width="60" height="14" as="geometry"/></mxCell><mxCell id="q154" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DCFCE7;strokeColor=#16A34A" vertex="1" parent="1"><mxGeometry x="130" y="1038" width="26" height="26" as="geometry"/></mxCell><mxCell id="q155" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="160" y="1038" width="26" height="26" as="geometry"/></mxCell><mxCell id="q156" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="190" y="1038" width="26" height="26" as="geometry"/></mxCell><mxCell id="q157" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="220" y="1038" width="26" height="26" as="geometry"/></mxCell><mxCell id="q158" value="item 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="1076" width="60" height="14" as="geometry"/></mxCell><mxCell id="q159" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="130" y="1068" width="26" height="26" as="geometry"/></mxCell><mxCell id="q160" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DCFCE7;strokeColor=#16A34A" vertex="1" parent="1"><mxGeometry x="160" y="1068" width="26" height="26" as="geometry"/></mxCell><mxCell id="q161" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="190" y="1068" width="26" height="26" as="geometry"/></mxCell><mxCell id="q162" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="220" y="1068" width="26" height="26" as="geometry"/></mxCell><mxCell id="q163" value="item 3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="1106" width="60" height="14" as="geometry"/></mxCell><mxCell id="q164" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="130" y="1098" width="26" height="26" as="geometry"/></mxCell><mxCell id="q165" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="160" y="1098" width="26" height="26" as="geometry"/></mxCell><mxCell id="q166" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DCFCE7;strokeColor=#16A34A" vertex="1" parent="1"><mxGeometry x="190" y="1098" width="26" height="26" as="geometry"/></mxCell><mxCell id="q167" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="220" y="1098" width="26" height="26" as="geometry"/></mxCell><mxCell id="q168" value="item 4" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=9.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="1136" width="60" height="14" as="geometry"/></mxCell><mxCell id="q169" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="130" y="1128" width="26" height="26" as="geometry"/></mxCell><mxCell id="q170" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="160" y="1128" width="26" height="26" as="geometry"/></mxCell><mxCell id="q171" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FEE2E2;strokeColor=#FCA5A5" vertex="1" parent="1"><mxGeometry x="190" y="1128" width="26" height="26" as="geometry"/></mxCell><mxCell id="q172" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#DCFCE7;strokeColor=#16A34A" vertex="1" parent="1"><mxGeometry x="220" y="1128" width="26" height="26" as="geometry"/></mxCell><mxCell id="q173" value="similarity of every item to every partner (one quarter of the full 128 × 128 matrix, which also compares items with items and partners with partners)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="1164" width="230" height="30" as="geometry"/></mxCell><mxCell id="q174" value="&lt;b&gt;1.&lt;/b&gt; Embed both sides and compare every item with every other item in the batch, on both sides." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="420" y="1010" width="640" height="18" as="geometry"/></mxCell><mxCell id="q175" value="&lt;b&gt;2.&lt;/b&gt; The loss (InfoNCE) is low when each item&#x27;s own partner (green diagonal) scores higher than all the decoys (red) and all the other items on its own side." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="420" y="1040" width="640" height="34" as="geometry"/></mxCell><mxCell id="q176" value="&lt;b&gt;3.&lt;/b&gt; The weights being trained are updated to raise the green scores and lower the others, and the next batch is drawn." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="420" y="1086" width="640" height="34" as="geometry"/></mxCell><mxCell id="q177" value="&lt;b&gt;Why it works without labels:&lt;/b&gt; the &quot;right answers&quot; come from the data itself (what is on the same street, what a building is tagged as). The decoys are the other items in the same batch, so no extra data is needed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#0F766E;fontStyle=0" vertex="1" parent="1"><mxGeometry x="420" y="1134" width="640" height="40" as="geometry"/></mxCell><mxCell id="q178" value="&lt;b&gt;What makes a good quiz&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1110" y="1010" width="620" height="18" as="geometry"/></mxCell><mxCell id="q179" value="• The partner must be &lt;b&gt;predictable&lt;/b&gt; from the item: names were dropped because an outline, or a pub&#x27;s type, cannot predict a name." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1110" y="1034" width="630" height="34" as="geometry"/></mxCell><mxCell id="q180" value="• The batch must be &lt;b&gt;varied&lt;/b&gt;: when 80% of context entries were &quot;building: house&quot;, streets all looked alike (fixed by collapsing houses)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1110" y="1074" width="630" height="34" as="geometry"/></mxCell><mxCell id="q181" value="• The pairing must be &lt;b&gt;meaningful and cover the data&lt;/b&gt;: stage 3&#x27;s bus-route pairing is neither, which is why it is being replaced." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1110" y="1114" width="630" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>