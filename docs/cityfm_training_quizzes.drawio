8" width="140" height="16" as="geometry"/></mxCell><mxCell id="q55" value="an entity and the street it is on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="578" width="380" height="44" as="geometry"/></mxCell><mxCell id="q56" value="&lt;b&gt;Different&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="50" y="628" width="140" height="16" as="geometry"/></mxCell><mxCell id="q57" value="the same entity and the other 63 streets and 63 entities" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="628" width="380" height="44" as="geometry"/></mxCell><mxCell id="q58" value="&lt;b&gt;Trained&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="50" y="678" width="140" height="16" as="geometry"/></mxCell><mxCell id="q59" value="BERT + text projection (T on both sides)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="678" width="380" height="44" as="geometry"/></mxCell><mxCell id="q60" value="&lt;b&gt;Should teach&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="50" y="728" width="140" height="16" as="geometry"/></mxCell><mxCell id="q61" value="things found together become similar: pubs near theatres and hostels, farms near fields and few houses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="728" width="380" height="44" as="geometry"/></mxCell><mxCell id="q62" value="&lt;b&gt;Settings (v5)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="50" y="778" width="140" height="16" as="geometry"/></mxCell><mxCell id="q63" value="625 steps of 4 quizzes; names left out, so a POI is read by its type only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="190" y="778" width="380" height="44" as="geometry"/></mxCell><mxCell id="q64" value="&lt;b&gt;Learns.&lt;/b&gt; With the POI held out, it finds the right street 7.0% of the time (top 5: 23%), against 4.2% (14%) for untuned BERT and 1.6% for guessing. Categories found together become more similar (ρ 0.62, BERT 0.18)." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="50" y="844" width="520" height="62" as="geometry"/></mxCell><mxCell id="q65" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="1"><mxGeometry x="620" y="146" width="560" height="790" as="geometry"/></mxCell><mxCell id="q66" value="&lt;b&gt;2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="636" y="160" width="28" height="28" as="geometry"/></mxCell><mxCell id="q67" value="&lt;b&gt;Stage 2 · Polygon: a footprint ↔ its building type&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="674" y="164" width="480" height="22" as="geometry"/></mxCell><mxCell id="q68" value="Quiz: 64 buildings, each with a different tag text. Each footprint (picture + floor area) must pick out its own text." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="198" width="520" height="32" as="geometry"/></mxCell><mxCell id="q69" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#94A3B8" vertex="1" parent="1"><mxGeometry x="640" y="252" width="58" height="58" as="geometry"/></mxCell><mxCell id="q70" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=2;fillColor=#334155;strokeColor=none" vertex="1" parent="1"><mxGeometry x="663.2" y="257.8" width="11.600000000000001" height="46.400000000000006" as="geometry"/></mxCell><mxCell id="q71" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=2;fillColor=#334155;strokeColor=none" vertex="1" parent="1"><mxGeometry x="648.7" y="270.56" width="40.599999999999994" height="10.44" as="geometry"/