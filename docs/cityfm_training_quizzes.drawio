nt="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="291" as="sourcePoint"/><mxPoint x="948" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q91" value="… and 61 more buildings in the same quiz" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="950" y="546" width="220" height="16" as="geometry"/></mxCell><mxCell id="q92" value="&lt;b&gt;Similar&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="578" width="140" height="16" as="geometry"/></mxCell><mxCell id="q93" value="a footprint and the text of its own building type" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="780" y="578" width="380" height="44" as="geometry"/></mxCell><mxCell id="q94" value="&lt;b&gt;Different&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="628" width="140" height="16" as="geometry"/></mxCell><mxCell id="q95" value="the same footprint and the other 63 texts and 63 footprints" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="780" y="628" width="380" height="44" as="geometry"/></mxCell><mxCell id="q96" value="&lt;b&gt;Trained&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="678" width="140" height="16" as="geometry"/></mxCell><mxCell id="q97" value="image network (from ImageNet) + footprint and area projections; the text side is frozen" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="780" y="678" width="380" height="44" as="geometry"/></mxCell><mxCell id="q98" value="&lt;b&gt;Should teach&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="728" width="140" height="16" as="geometry"/></mxCell><mxCell id="q99" value="a footprint&#x27;s embedding is most similar to the text embedding of its own type, so shape and size can predict missing tags" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="780" y="728" width="380" height="44" as="geometry"/></mxCell><mxCell id="q100" value="&lt;b&gt;Settings (v5)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="640" y="778" width="140" height="16" as="geometry"/></mxCell><mxCell id="q101" value="1,250 steps of 4 quizzes; footprints drawn in metres; names left out (an outline cannot show a name)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="780" y="778" width="380" height="44" as="geometry"/></mxCell><mxCell id="q102" value="&lt;b&gt;Learns.&lt;/b&gt; A building&#x27;s class (18 classes) can be read from its footprint embedding 57% of the time, against 19% from floor area alone; matching footprints straight to class texts works 47% of the time (chance 6%)." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="640" y="844" width="520" height="62" as="geometry"/></mxCell><mxCell id="q103" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1" vertex="1" parent="1"><mxGeometry x="1210" y="146" width="560" height="790" as="geometry"/></mxCell><mxCell id="q104" value="&lt;b&gt;3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#1E293B;strokeColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#FFFFFF;align=center;verticalAlign=middle" vertex="1" parent="1"><mxGeometry x="1226" y="160" width="28" height="28" as="geometry"/></mxCell><mxCell id="q105" value="&lt;b&gt;Stage 3 · Relation: a street ↔ a similar street&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1264" y="164" width="480" height="22" as="geometry"/></mxCell><mxCell id="q106" value="Quiz: streets on bus routes are paired with another street carrying almost the same number of bus routes, anywhere in Leeds; each context must pick out its partner&#x27;s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=11.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1230" y="198" width="520" height="32" as="geometry"/></mxCell><mxCell id="q107" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=1.2" vertex="1" parent="1"><mxGeometry x="1230" y="246" width="210" height="84" as="geometry"/></mxCell><mxCell id="q108" value="street with 24 routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1238" y="250" width="194" height="14" as="geometry"/></mxCell><mxCell id="q109" value="amenity: bus station" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1238.0" y="266" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q110" value="shop: clothes" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1339.0" y="266" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q111" value="amenity: bank" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1238.0" y="295" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q112" value="amenity: cafe" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1339.0" y="295" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q113" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=1.2" vertex="1" parent="1"><mxGeometry x="1540" y="246" width="210" height="84" as="geometry"/></mxCell><mxCell id="q114" value="another street with 24 routes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=10;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="1548" y="250" width="194" height="14" as="geometry"/></mxCell><mxCell id="q115" value="amenity: fast food" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1548.0" y="266" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q116" value="shop: mobile phone" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="1649.0" y="266" width="93.0" height="25" as="geometry"/></mxCell><mxCell id="q117" value="amenity: pharmacy" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=9;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mx