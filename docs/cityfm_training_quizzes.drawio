<mxfile host="Electron" type="device"><diagram id="cityfm-training-quizzes" name="CityFM training: three matching quizzes"><mxGraphModel dx="1800" dy="1235" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1235" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q11" value="&lt;b&gt;How CityFM learns: three matching quizzes&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=26;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1200" height="34" as="geometry"/></mxCell><mxCell id="q12" value="Every stage shows the model a batch of pairs that belong together, shuffled. Training adjusts the model so that each item is more similar to its own partner than to any other item in the batch, on either side. Over thousands of quizzes, things that belong together become close together in the embedding space." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#64748B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1500" height="36" as="geometry"/></mxCell><mxCell id="q13" value="T" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="30" y="108" width="22" height="18" as="geometry"/></mxCell><mxCell id="q14" value="text embedding (BERT, tags read without names)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="60" y="109" width="300" height="16" as="geometry"/></mxCell><mxCell id="q15" value="V" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6" vertex="1" parent="1"><mxGeometry x="360" y="108" width="22" height="18" as="geometry"/></mxCell><mxCell id="q16" value="footprint embedding (image network + floor area)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="390" y="109" width="320" height="16" as="geometry"/></mxCell><mxCell id="q17" value="" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;opacity=55;dashed=1;dashPattern=3 2" vertex="1" parent="1"><mxGeometry x="720" y="108" width="22" height="18" as="geometry"/></mxCell><mxCell id="q18" value="frozen in this stage" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#1E293B;fontStyle=0" vertex="1" parent="1"><mxGeometry x="750" y="109" width="150" height="16" as="geometry"/></mxCell><mxCell id="q19" value="" style="edgeStyle=none;html=1;strokeColor=#16A34A;strokeWidth=2.2;endArrow=block;endFill=1;endSize=4;startArrow=block;startFill=1;startSize=4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="117" as="sourcePoint"/><mxPoint x="950" y="117" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q20" value="made more similar: true partners" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=