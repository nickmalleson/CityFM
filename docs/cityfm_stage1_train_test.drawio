<mxCell id="s1" value="&lt;b&gt;Stage 1: how CityFM learns what is found together, and how we test it&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=30;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="40" as="geometry"/></mxCell>
<mxCell id="s2" value="Everything on the map is read as its type only (e.g. &lt;i&gt;amenity: cafe&lt;/i&gt;), with no names. A street is described by the list of things near it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1540" height="26" as="geometry"/></mxCell>
