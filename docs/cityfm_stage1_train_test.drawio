<mxCell id="s124" value="&lt;b&gt;7.0%&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#1E293B" vertex="1" parent="1"><mxGeometry x="1292.0" y="770" width="80" height="22" as="geometry"/></mxCell>
<mxCell id="s125" value="Much harder. CityFM beats untuned BERT (and has the right street in its top 5 in 23% of quizzes)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="1110" y="800" width="470" height="40" as="geometry"/></mxCell>
<mxCell id="s126" value="&lt;b&gt;What it shows.&lt;/b&gt; Training has taught CityFM something: it beats the untuned language model in both tests. But with the object held out it is no better than tag matching, so it may lean on spotting repeats. &lt;b&gt;Next:&lt;/b&gt; hold the object out during training too, so the shortcut is not available." style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.2;fontFamily=Helvetica;fontSize=15;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingLeft=14;spacingRight=14" vertex="1" parent="1"><mxGeometry x="30" y="870" width="1570" height="76" as="geometry"/></mxCell>
<mxCell id="s127" value="&lt;b&gt;Guessing&lt;/b&gt;: 1 in 64.   &lt;b&gt;Tag matching&lt;/b&gt;: no model; pick the street with the most items of exactly the same type.   &lt;b&gt;Untuned BERT&lt;/b&gt;: the language model before CityFM's training.   Same scale in both charts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#64748B" vertex="1" parent="1"><mxGeometry x="30" y="958" width="1570" height="20" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
